{
  "name": "abl-oeunit-test-explorer",
  "displayName": "OpenEdge ABL OEUnit Test Explorer",
  "description": "Run and explore OpenEdge ABL unit tests using OEUnit",
  "version": "0.2.0",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/orombauts/oeunit-test-explorer.git"
  },
  "publisher": "CsysOlivierRombauts",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "workspaceContains:**/*.cls",
    "workspaceContains:**/*.p"
  ],
  "main": "./out/extension.js",
  "extensionOptionalDependencies": [
    "RiversideSoftware.openedge-abl-lsp"
  ],
  "contributes": {
    "commands": [
      {
        "command": "oeunit.restartServer",
        "title": "OEUnit: Restart Server"
      },
      {
        "command": "oeunit.stopServer",
        "title": "OEUnit: Stop Server"
      },
      {
        "command": "oeunit.startServer",
        "title": "OEUnit: Start Server"
      },
      {
        "command": "oeunit.killServer",
        "title": "OEUnit: Kill Server"
      },
      {
        "command": "oeunit.pingServer",
        "title": "OEUnit: Ping Server"
      },
      {
        "command": "oeunit.startAllServers",
        "title": "OEUnit: Start All Servers (Experimental)"
      },
      {
        "command": "oeunit.stopAllServers",
        "title": "OEUnit: Stop All Servers (Experimental)"
      },
      {
        "command": "oeunit.restartAllServers",
        "title": "OEUnit: Restart All Servers (Experimental)"
      }
    ],
    "configuration": {
      "title": "OEUnit Test Explorer",
      "properties": {
        "oeunit.exec": {
          "type": "string",
          "default": "_progres.exe",
          "description": "OpenEdge executable name"
        },
        "oeunit.oeargs": {
          "type": "string",
          "default": "-cpinternal utf-8 -cpstream utf-8 -cpcoll Basic -cpcase Basic",
          "description": "Additional OpenEdge arguments"
        },
        "oeunit.testFilePattern": {
          "type": "string",
          "default": "**/test/**/*.cls",
          "description": "Glob pattern to find test files"
        },
        "oeunit.port": {
          "type": "number",
          "default": 5555,
          "description": "Port number for the OEUnit persistent server"
        },
        "oeunit.timeout": {
          "type": "number",
          "default": 60,
          "description": "Socket timeout in seconds for client connections and server reads (default: 60)"
        },
        "oeunit.loglevel": {
          "type": "string",
          "default": "error",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "description": "Log level for OEUnit server (info=all messages, warning=warning+error, error=error only)"
        },
        "oeunit.workspaceFolder": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Workspace folder path to use for OEUnit server (defaults to first workspace folder if not specified)"
        },
        "oeunit.autostart": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the OEUnit server when the extension activates"
        },
        "oeunit.environmentVariables": {
          "type": "object",
          "default": {},
          "description": "Environment variables to set when starting the Progress executable. These can override DLC and PROPATH if needed.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "oeunit.multiProjectMode": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "**[Experimental]** Enable multi-project workspace support. When enabled, the extension scans all `openedge-project.json` files in the workspace, starts a dedicated OEUnit server per project (on separate ports), and maps test items to their owning project. Requires a window reload to take full effect."
        },
        "oeunit.portBase": {
          "type": "number",
          "default": 5555,
          "description": "Base port used when multi-project mode allocates dedicated server ports"
        },
        "oeunit.portStep": {
          "type": "number",
          "default": 10,
          "description": "Port increment applied between multi-project OEUnit servers"
        },
        "oeunit.projects": {
          "type": "object",
          "default": {},
          "description": "Per-project overrides keyed by project identifier (advanced)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  }
}
